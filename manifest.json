{
  "manifest_version": 3,
  "name": "Funnel Navigator for CheckoutChamp",
  "version": "3.0.0",
  "description": "Unofficial tool for quick access to CheckoutChamp funnel pages with one-click URL generation for viewing, editing, and previewing",
  "author": "Your Name",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "optional_permissions": [
    "declarativeContent"
  ],
  "host_permissions": [
    "https://*.checkoutchamp.com/*",
    "https://*.thisisatestsiteonly.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.checkoutchamp.com/*",
        "https://*.thisisatestsiteonly.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
